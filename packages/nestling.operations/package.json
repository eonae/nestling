{
  "name": "@nestling/operations",
  "version": "0.1.0",
  "description": "Direction-neutral declarations for Nestling: operations, fail definitions, io forms and the HTTP bind map — no server code, no runtime dependencies",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@common/misc": "workspace:*",
    "@nestling/container": "workspace:*",
    "@nestling/streams": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "zod": "^4.0.0"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          "build"
        ]
      }
    }
  }
}
