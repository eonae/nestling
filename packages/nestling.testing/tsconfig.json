{
  // Проект пакета: по нему работают редактор и ESLint. Покрывает весь
  // TypeScript пакета, спеки в том числе, — иначе у них нет типов
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Сборка идёт по `tsconfig.build.json`
    "noEmit": true,

    // Пакет живёт по ту сторону условия: `@nestling/app/testing` резолвится
    // только с ним — ровно та граница, которую пакет предлагает
    // пользовательским модулям
    "customConditions": ["testing"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
