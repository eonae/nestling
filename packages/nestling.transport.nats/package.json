{
  "name": "@nestlingjs/transport.nats",
  "version": "0.1.0",
  "description": "NATS как шина приложения: доставляет вызовы операций между процессами в обе стороны",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "nats",
    "message-bus",
    "events"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.transport.nats"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.transport.nats#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "dependencies": {
    "@nestlingjs/app": "workspace:*",
    "@nestlingjs/container": "workspace:*",
    "@nestlingjs/operations": "workspace:*",
    "nats": "^2.29.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
