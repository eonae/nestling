{
  // Проект пакета: по нему работают редактор и ESLint. Покрывает весь
  // TypeScript пакета, спеки в том числе, — иначе у них нет типов
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Сборка идёт по `tsconfig.build.json`
    "noEmit": true,

    // Тесты берут тестовый корень (`@nestling/testing`), который живёт по ту
    // сторону условия: без него subpath-шов не резолвится при typecheck.
    // Прод-код пакета к нему не обращается — в `dependencies` его нет
    "customConditions": ["testing"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
