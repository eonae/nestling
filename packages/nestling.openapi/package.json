{
  "name": "@nestlingjs/openapi",
  "version": "0.1.2",
  "description": "Документ OpenAPI 3.1 из тех же деклараций endpoint'ов, которые обслуживают запросы: конвертеры схем приходят данными, зависимости от валидатора нет",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "openapi",
    "swagger",
    "schema"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.openapi"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.openapi#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "dependencies": {
    "@nestlingjs/app": "workspace:*",
    "@nestlingjs/container": "workspace:*",
    "@nestlingjs/operations": "workspace:*",
    "@nestlingjs/transport.http": "workspace:*"
  },
  "devDependencies": {
    "@nestlingjs/openapi.zod": "workspace:*",
    "@nestlingjs/transport.cli": "workspace:*",
    "typescript": "5.7.3",
    "zod": "^4.0.0"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          "build"
        ]
      }
    }
  }
}
