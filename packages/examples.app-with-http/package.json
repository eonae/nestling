{
  "name": "examples.app-with-http",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/bundle.js",
  "exports": {
    ".": "./dist/bundle.js",
    "./testing": {
      "testing": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run typecheck && yarn run clear && node esbuild.config.js",
    "start": "yarn run build && node dist/bundle.js",
    "start:dev": "run -T tsx src/main.ts",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules run -T jest --config jest.e2e.config.js",
    "test:all": "yarn run test && yarn run test:e2e",
    "client": "run -T tsx src/api.client.ts"
  },
  "dependencies": {
    "@common/misc": "workspace:*",
    "@nestling/app": "workspace:*",
    "@nestling/client": "workspace:*",
    "@nestling/config": "workspace:*",
    "@nestling/container": "workspace:*",
    "@nestling/contracts": "workspace:*",
    "@nestling/openapi": "workspace:*",
    "@nestling/openapi.zod": "workspace:*",
    "@nestling/pipeline": "workspace:*",
    "@nestling/ports": "workspace:*",
    "@nestling/streams": "workspace:*",
    "@nestling/subscriptions": "workspace:*",
    "@nestling/transport": "workspace:*",
    "@nestling/transport.http": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestling/eslint-plugin": "workspace:*",
    "@nestling/testing": "workspace:*"
  },
  "nx": {
    "targets": {
      "lint": {
        "dependsOn": [
          "@nestling/eslint-plugin:build"
        ]
      }
    }
  }
}
