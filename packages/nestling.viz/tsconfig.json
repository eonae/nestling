{
  // Проект пакета: по нему работают редактор и ESLint. Покрывает весь
  // TypeScript пакета — и CLI, и React-приложение под `src/static`.
  // Сборку делают esbuild (CLI) и vite (веб), поэтому `tsconfig.build.json`
  // здесь нет, а tsc только тайпчекает
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,

    // Веб-часть: React и браузерное окружение
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/static/src/*"],
      "@core/*": ["src/static/src/core/*"],
      "@components/*": ["src/static/src/components/*"],
      "@hooks/*": ["src/static/src/hooks/*"],
      "@types/*": ["src/static/src/types/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
