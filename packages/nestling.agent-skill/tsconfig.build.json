{
  // Сборка пакета. Отличается от проекта пакета тем, что эмитит в `dist` и
  // не берёт туда ни спеки, ни сниппеты: сниппеты нужны только проверке
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules",
    "snippets",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.type-test.ts",
    "src/**/__fixtures__/**"
  ]
}
