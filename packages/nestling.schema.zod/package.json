{
  "name": "@nestlingjs/schema.zod",
  "version": "0.3.0",
  "description": "Всё, что Nestling делает с zod: конвертер схем в JSON Schema, билдеры полей секций конфигурации и модели, сверяемые с TypeScript-типом",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "zod",
    "schema",
    "json-schema",
    "validation"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.schema.zod"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.schema.zod#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "node ../../scripts/build-package.mjs",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "run -T vitest run"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@nestlingjs/app": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "zod": "^4.0.0"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          "build"
        ]
      }
    }
  }
}
