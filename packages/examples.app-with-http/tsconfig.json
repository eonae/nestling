{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // `await using` в app-тестах примера
    "lib": ["es2022", "dom", "dom.iterable", "esnext.disposable"],
    // Пример импортирует `@nestling/testing`, который живёт по ту сторону
    // условия: без него subpath-шов не резолвится при typecheck
    "customConditions": ["testing"]
  },
  "include": ["src/**/*"]
}

