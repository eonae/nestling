{
  "name": "@nestling/app",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "clear": "rm -rf dist",
    "build": "yarn run clear && run -T tsc",
    "lint": "run -T eslint 'src/**/*.ts'",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@common/misc": "workspace:*",
    "@nestling/config": "workspace:*",
    "@nestling/container": "workspace:*",
    "@nestling/contracts": "workspace:*",
    "@nestling/pipeline": "workspace:*",
    "@nestling/ports": "workspace:*",
    "@nestling/transport": "workspace:*"
  },
  "devDependencies": {
    "@nestling/transport.cli": "workspace:*",
    "@nestling/transport.http": "workspace:*",
    "zod": "^4.0.0"
  }
}
