{
  "name": "@nestlingjs/testing",
  "version": "0.1.3",
  "description": "Тестовый composition root: та же декларация приложения проходит фазы до WIRE и останавливается — dispatch создан, сокеты не открыты",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "testing",
    "jest",
    "integration-testing"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.testing"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.testing#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "dependencies": {
    "@nestlingjs/app": "workspace:*",
    "@nestlingjs/container": "workspace:*",
    "@nestlingjs/operations": "workspace:*"
  },
  "devDependencies": {
    "@nestlingjs/transport.http": "workspace:*",
    "typescript": "5.7.3",
    "zod": "^4.0.0"
  }
}
