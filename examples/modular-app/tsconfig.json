{
  // Проект пакета: по нему работают редактор и ESLint. Покрывает весь
  // TypeScript пакета, спеки в том числе, — иначе у них нет типов
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Сборка идёт по `tsconfig.build.json`
    "noEmit": true,

    // `drizzle-orm` везёт объявления всех своих диалектов одним пакетом, и
    // среди них — типы драйверов, которых здесь нет (`gel`, `mysql2`)
    "skipLibCheck": true,

    // Двойник брокера и шов тестового корня живут по ту сторону условия
    // `testing`: без него subpath-шов не резолвится при typecheck
    "customConditions": ["testing"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
