{
  "name": "@nestlingjs/app",
  "version": "0.1.2",
  "description": "Ядро Nestling одним пакетом: пайплайн обработки запроса, конфигурация, порты между фичами, абстракция транспорта и композиционный корень",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "framework",
    "dependency-injection",
    "backend"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.app"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.app#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests",
    "type-budget": "run -T tsx type-tests/bench/run.ts"
  },
  "dependencies": {
    "@nestlingjs/common.misc": "workspace:*",
    "@nestlingjs/container": "workspace:*",
    "@nestlingjs/operations": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.0.0"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          "build"
        ]
      }
    }
  }
}
