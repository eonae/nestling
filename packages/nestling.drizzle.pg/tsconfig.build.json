{
  // Сборка пакета. Отличается от проекта пакета только тем, что эмитит в
  // `dist` и не берёт туда тестовый код: спеки, проверки типов и фикстуры
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Объявления таблиц отдают наружу тип drizzle: у `inboxTable()` он
    // занимает 60 строк, у `outboxTable()` — 230, и это метаданные каждой
    // колонки, которые меняются с версией drizzle. Написать такой тип
    // аннотацией нельзя без того, чтобы он поехал на первом обновлении.
    // Поэтому декларации этого пакета выводит `tsc` по всей программе —
    // он один такой в репозитории
    "isolatedDeclarations": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules",
    "e2e",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.type-test.ts",
    "src/**/__fixtures__/**"
  ]
}
