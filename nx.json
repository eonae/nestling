{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "tsconfigs": [
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/tsconfig.build.json"
    ],
    "src": [
      "{projectRoot}/src/**/*.ts"
    ],
    "sources": [
      "{projectRoot}/src/**/*",
      "{projectRoot}/e2e/**/*",
      "{projectRoot}/type-tests/**/*",
      "!{projectRoot}/type-tests/.generated/**/*"
    ],
    "build": [
      "src",
      "!{projectRoot}/src/**/*.{spec,test}.ts",
      "{projectRoot}/package.json",
      "tsconfigs"
    ],
    "check": [
      "sources",
      "{projectRoot}/eslint.config.js",
      "tsconfigs",
      "{projectRoot}/package.json"
    ],
    "test": [
      "sources",
      "tsconfigs",
      "{projectRoot}/jest.config.*",
      "{projectRoot}/package.json"
    ],
    "type-budget": [
      "src",
      "{projectRoot}/type-tests/**/*",
      "!{projectRoot}/type-tests/.generated/**/*",
      "tsconfigs",
      "{projectRoot}/package.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": [
        "build"
      ],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "check"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "check"
      ],
      "dependsOn": [
        "@nestling/eslint-plugin:build"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "test"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "type-budget": {
      "inputs": [
        "type-budget",
        "^src"
      ],
      "cache": true
    }
  }
}
