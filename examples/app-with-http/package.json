{
  "name": "@examples/app-with-http",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/bundle.js",
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run typecheck && yarn run clear && node esbuild.config.js",
    "start": "yarn run build && node dist/bundle.js",
    "start:dev": "run -T tsx src/main.ts",
    "client": "run -T tsx src/api/client.ts",
    "openapi": "run -T tsx src/openapi.ts",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules run -T jest --config jest.e2e.config.js",
    "test:all": "yarn run test && yarn run test:e2e"
  },
  "dependencies": {
    "@nestlingjs/app": "workspace:*",
    "@nestlingjs/client": "workspace:*",
    "@nestlingjs/container": "workspace:*",
    "@nestlingjs/openapi": "workspace:*",
    "@nestlingjs/openapi.zod": "workspace:*",
    "@nestlingjs/operations": "workspace:*",
    "@nestlingjs/subscriptions": "workspace:*",
    "@nestlingjs/transport.http": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestlingjs/eslint-plugin": "workspace:*",
    "@nestlingjs/testing": "workspace:*"
  },
  "nx": {
    "targets": {
      "lint": {
        "dependsOn": [
          "@nestlingjs/eslint-plugin:build"
        ]
      }
    }
  }
}
