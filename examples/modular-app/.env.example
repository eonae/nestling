# Адрес базы данных: пользователь, пароль, хост и имя базы
DATABASE_URL=postgresql://modular:modular@localhost:5433/modular

# Сколько соединений держит пул
DATABASE_POOL_MAX=10

# Адрес базы для спеков; без него они пропускаются
TEST_DATABASE_URL=postgresql://modular:modular@localhost:5433/modular

# Адрес брокера
NATS_SERVERS=nats://127.0.0.1:4222

# Выбор фич процесса: `all`, `users` или `notifications`
APP_FEATURES=all

# Чем отправлять письма: `log` или `smtp`
APP_MAIL=log

# Порт HTTP-сервера проб и метрик
HTTP_PORT=3100

# Сколько отметка приёма живёт до уборки, миллисекунды; срок обязан
# перекрывать окно повторов брокера
INBOX_RETENTION_MS=604800000

# Чистит ли таблицу отметок этот процесс
INBOX_SWEEP=true
