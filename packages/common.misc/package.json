{
  "name": "@nestlingjs/common.misc",
  "version": "0.3.0",
  "description": "Схемный кернел Nestling поверх Standard Schema и общие вспомогательные типы — внутренний пакет",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "standard-schema",
    "validation",
    "internal"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/common.misc"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/common.misc#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "node ../../scripts/build-package.mjs",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "run -T vitest run"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "zod": "^4.0.0"
  }
}
