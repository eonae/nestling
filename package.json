{
  "name": "nestling",
  "version": "0.1.0",
  "description": "A TypeScript backend framework written by agents: it shortens the time between the code being written and the code being known to be correct",
  "repository": {
    "type": "git",
    "url": "https://github.com/eonae/nestling"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "nx": "NX_CACHE_DIRECTORY=\"${HOME}/.cache/nestling/nx\" nx",
    "verify": "yarn nx run-many -t build typecheck lint test type-budget && node scripts/smoke.mjs && node scripts/boundary/public-api-validator.mjs",
    "verify:fresh": "yarn nx run-many -t build typecheck lint test type-budget --skip-nx-cache && node scripts/smoke.mjs && node scripts/boundary/public-api-validator.mjs",
    "verify:strict": "yarn nx run-many -t build && tsc -p tsconfig.strict.json",
    "bench:http": "tsx scripts/bench/http.ts",
    "docs:audit": "node .claude/skills/docs-audit/scripts/check.mjs",
    "docs:build": "node scripts/site/build.mjs",
    "docs:dev": "node scripts/site/build.mjs --watch",
    "pack:check": "node scripts/pack-check.mjs",
    "test:live": "node scripts/test-live.mjs"
  },
  "resolutions": {
    "@types/estree": "1.0.9"
  },
  "devDependencies": {
    "@eslint/compat": "~1.1.1",
    "@eslint/js": "^9.10.0",
    "@hono/node-server": "^2.1.1",
    "@nestlingjs/common.static-server": "workspace:*",
    "@nestlingjs/eslint-plugin": "workspace:*",
    "@rsdk/prettier-config": "^6.0.0-next.14",
    "@swc/core": "^1.16.2",
    "@tanstack/eslint-plugin-router": "^1.132.21",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.0",
    "esbuild": "0.21.4",
    "eslint": "^9.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^55.0.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "express": "^5.2.1",
    "fastify": "^5.12.3",
    "globals": "^15.9.0",
    "hono": "^4.13.7",
    "lerna": "^8.0.0",
    "markdown-it": "^15.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "nx": "20.8.2",
    "open": "^10.2.0",
    "pg": "^8.16.0",
    "prettier": "^3.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.5.0",
    "unplugin-swc": "^1.6.0",
    "vite": "^7",
    "vitest": "^5.0.0",
    "zod": "^4.0.0"
  },
  "packageManager": "yarn@4.1.0"
}
