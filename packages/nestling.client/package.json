{
  "name": "@nestlingjs/client",
  "version": "0.1.1",
  "description": "Типизированный HTTP-клиент из деклараций операций: вызов метода API устроен так же, как вызов порта, а зависимостей у пакета нет, кроме @nestlingjs/operations",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "http-client",
    "typed-client",
    "contracts"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.client"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.client#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "dependencies": {
    "@nestlingjs/operations": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "zod": "^4.0.0"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          "build"
        ]
      }
    }
  }
}
