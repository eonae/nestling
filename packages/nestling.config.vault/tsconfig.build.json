{
  // Сборка пакета. Отличается от проекта пакета только тем, что эмитит в
  // `dist` и не берёт туда тестовый код: спеки, проверки типов и `e2e`
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Декларация выводится из одного файла, без программы: это то, что
    // позволяет сборке не быть четвёртым тайпчеком того же кода. Цена —
    // публичный экспорт обязан нести явную аннотацию, и тип публичного
    // имени становится написанным, а не выведенным по случайности
    "isolatedDeclarations": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules",
    "e2e",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.type-test.ts",
    "src/**/__fixtures__/**"
  ]
}
