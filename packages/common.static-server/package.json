{
  "name": "@common/static-server",
  "version": "0.1.0",
  "description": "Very simple (no deps) server for serving static files in dev",
  "type": "module",
  "main": "dist/out.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "author": "",
  "license": "MIT"
}
