{
  "name": "@nestlingjs/transport.http",
  "version": "0.1.3",
  "description": "HTTP-транспорт Nestling на node:http: маршрутизация, разбор тела по io-декларации endpoint'а и выбор формата ответа по ней же",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "http",
    "server",
    "router"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.transport.http"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.transport.http#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "dependencies": {
    "@nestlingjs/app": "workspace:*",
    "@nestlingjs/container": "workspace:*",
    "@nestlingjs/operations": "workspace:*",
    "busboy": "^1.6.0",
    "find-my-way": "^8.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestlingjs/client": "workspace:*",
    "@nestlingjs/common.misc": "workspace:*",
    "@types/busboy": "^1.5.4"
  }
}
