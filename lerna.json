{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "0.1.0",
  "npmClient": "yarn",
  "command": {
    "publish": {
      "message": "chore(release): publish",
      "removePackageFields": ["devDependencies", "scripts"],
      "sort": true
    },
    "version": {
      "push": false,
      "private": false
    }
  }
}
