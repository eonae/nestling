{
  // Сборка пакета. Отличается от проекта пакета только тем, что эмитит в
  // `dist` и не берёт туда тестовый код: спеки, проверки типов и фикстуры
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules",
    "e2e",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.type-test.ts",
    "src/**/__fixtures__/**"
  ]
}
