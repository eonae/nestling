{
  "name": "@nestlingjs/eslint-plugin",
  "version": "0.1.3",
  "description": "Правила ESLint для кода на Nestling: граница модуля по баррель-файлу, подсказка про слой в декларации endpoint'а и список зависимостей класса против параметров конструктора",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "eslint",
    "eslintplugin",
    "lint"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.eslint-plugin"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@typescript-eslint/utils": "8.44.1",
    "eslint": "^9.2.5",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.5.0"
  }
}
