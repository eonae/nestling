{
  "name": "@nestlingjs/container",
  "version": "0.1.3",
  "description": "Контейнер зависимостей на стандартных декораторах ECMAScript с полной проверкой графа на сборке",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "dependency-injection",
    "ioc",
    "decorators"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.container"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.container#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "dependencies": {
    "@nestlingjs/common.graphs": "workspace:*",
    "@standard-schema/spec": "^1.1.0"
  }
}
