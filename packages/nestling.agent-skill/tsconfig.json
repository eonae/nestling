{
  // Проект пакета: по нему работают редактор и ESLint. Покрывает весь
  // TypeScript пакета — `src` со спеками и `snippets` с примерами кода для
  // скилла. Сниппеты входят сюда, потому что их смысл в том, чтобы
  // компилироваться против настоящего API соседних пакетов
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Сборка идёт по `tsconfig.build.json`
    "noEmit": true,

    // Сниппет теста импортирует `@nestlingjs/testing`, который живёт по ту
    // сторону условия: без него subpath-шов не резолвится при typecheck
    "customConditions": ["testing"],

    // Сниппеты скилла написаны глобалами раннера: скилл говорит о проекте
    // пользователя, а там раннер свой, и навязывать ему импорт из `vitest`
    // сниппет не должен. Типы глобалов объявлены здесь, а не в
    // `tsconfig.base.json`: в спеках репозитория их быть не должно —
    // спека называет то, чем написана, импортом
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "snippets"],
  "exclude": ["dist", "node_modules"]
}
