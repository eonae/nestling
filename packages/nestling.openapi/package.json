{
  "name": "@nestling/openapi",
  "version": "0.1.0",
  "description": "OpenAPI 3.1 document generated from Nestling endpoint declarations — no validator dependency, converters come as data",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "yarn run clear && run -T tsc -p tsconfig.build.json",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nestling/app": "workspace:*",
    "@nestling/container": "workspace:*",
    "@nestling/contracts": "workspace:*",
    "@nestling/pipeline": "workspace:*",
    "@nestling/ports": "workspace:*",
    "@nestling/transport.http": "workspace:*"
  },
  "devDependencies": {
    "@nestling/openapi.zod": "workspace:*",
    "@nestling/transport": "workspace:*",
    "@nestling/transport.cli": "workspace:*",
    "typescript": "5.7.3",
    "zod": "^4.0.0"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          "build"
        ]
      }
    }
  }
}
