{
  "name": "@nestling/ports",
  "version": "0.1.0",
  "description": "Contracts, ports and the in-process message bus for Nestling",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clear": "rm -rf dist",
    "build": "yarn run clear && run -T tsc",
    "lint": "run -T eslint 'src/**/*.ts'",
    "lint:fix": "yarn run lint --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules run -T jest --passWithNoTests"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@common/misc": "workspace:*",
    "@nestling/config": "workspace:*",
    "@nestling/container": "workspace:*",
    "@nestling/pipeline": "workspace:*",
    "@nestling/streams": "workspace:*",
    "@nestling/transport": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "zod": "^4.0.0"
  }
}
