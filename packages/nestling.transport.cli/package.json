{
  "name": "@nestlingjs/transport.cli",
  "version": "0.4.0",
  "description": "CLI-транспорт Nestling: те же endpoint'ы и пайплайны, что в HTTP, но вместо маршрутов — команды, а stdin служит потоковым входом",
  "keywords": [
    "nestling",
    "typescript",
    "esm",
    "cli",
    "command-line"
  ],
  "license": "MIT",
  "author": "eonae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonae/nestling.git",
    "directory": "packages/nestling.transport.cli"
  },
  "homepage": "https://github.com/eonae/nestling/tree/main/packages/nestling.transport.cli#readme",
  "bugs": {
    "url": "https://github.com/eonae/nestling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "typecheck": "run -T tsc -p tsconfig.json",
    "build": "node ../../scripts/build-package.mjs",
    "lint": "run -T eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "run -T vitest run"
  },
  "dependencies": {
    "@nestlingjs/app": "workspace:*",
    "@nestlingjs/container": "workspace:*",
    "@nestlingjs/operations": "workspace:*",
    "@nestlingjs/schema.zod": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.0.0"
  }
}
