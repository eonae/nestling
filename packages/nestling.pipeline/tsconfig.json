{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  // Явный include: каталог `type-tests/` содержит фикстуры, которые
  // ОБЯЗАНЫ не компилироваться (их диагностики — предмет снапшотов),
  // и в сборку пакета попадать не должен.
  "include": ["src"]
}

