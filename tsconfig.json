{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Корневой конфиг — запасной вариант редактора для файлов вне пакетов и
    // ad-hoc запуски tsc из корня. Каждый файл пакета или примера покрыт его
    // собственным `tsconfig.json`, сборка идёт по `tsconfig.build.json`
    "noEmit": true
  },
  "exclude": ["node_modules", "dist", "packages/*/dist", "examples/*/dist"]
}
