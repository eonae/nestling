{
  // Проект пакета: по нему работают редактор и ESLint. Покрывает весь
  // TypeScript пакета — спеки и `e2e` в том числе, иначе у них нет типов
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Сборка идёт по `tsconfig.build.json`
    "noEmit": true,

    // Объявления таблиц отдают наружу тип drizzle: у `inboxTable()` он
    // занимает 60 строк, у `outboxTable()` — 230, и это метаданные каждой
    // колонки, которые меняются с версией drizzle. Написать такой тип
    // аннотацией нельзя без того, чтобы он поехал на первом обновлении,
    // поэтому декларации этого пакета по-прежнему выводит `tsc` по всей
    // программе, а не swc по одному файлу
    "isolatedDeclarations": false,

    // Тесты берут тестовый корень (`@nestlingjs/testing`), который живёт по ту
    // сторону условия: без него subpath-шов не резолвится при typecheck.
    // Прод-код пакета к нему не обращается — в `dependencies` его нет
    "customConditions": ["testing"]
  },
  "include": ["src", "e2e"],
  "exclude": ["dist", "node_modules"]
}
