# Адрес базы данных: пользователь, пароль, хост и имя базы
DATABASE_URL=postgresql://users:users@localhost:5432/users

# Сколько соединений держит пул
DATABASE_POOL_MAX=10

# Адрес базы для спеков; без него они пропускаются
TEST_DATABASE_URL=postgresql://users:users@localhost:5432/users

# Bearer-токен для запросов, меняющих данные
API_TOKEN=dev-token

# Размер страницы списка пользователей
APP_PAGE_SIZE=20

# Порт HTTP-сервера
HTTP_PORT=3000
